#!/bin/bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$DIR/$SOURCE" ;;
  esac
done
REPO_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
MANIFEST="$REPO_DIR/skills/.vendor-manifest.json"
GROUPS_FILE="$REPO_DIR/skills/.groups.json"
PROVENANCE="$REPO_DIR/skills/.provenance.json"
COMPOSITES="$REPO_DIR/skills/.composites.json"
source "$REPO_DIR/scripts/worktree-lib.sh"
LINK_TARGETS=(
  "$HOME/.agents/skills"
  "$HOME/.claude/skills"
  "$HOME/.codex/skills"
)

usage() {
  cat <<'EOF'
Usage: skills <command> [args]

Commands:
  list                                  Print the grouped repo skill catalog
  install [--all|skill...]              Link repo skills globally
  add <source> [--skill name] [--list]  Clone/import skills into this repo
  worktree create <slug>                Create an isolated review worktree
  updates check [selectors...]          Check original sources for updates
  updates prepare [selectors...]        Prepare updates in a linked worktree
  updates verify                        Verify an update worktree
  updates promote <branch>              Fast-forward a verified branch into main
  apply                                 Apply repo configs and install all skills
  sync-settings [branch-name]            Branch, fetch app settings, and show review diff
  update-repo                           Deprecated alias for updates prepare --all
  sync-vendor [skill...]                Sync direct mirrors in a linked worktree
  doctor                                Check local setup
  help                                  Show this help

The add command is backed by this repo's local skills-cli copy. It keeps
upstream source parsing and skill discovery, but always imports into this
repo's skills/ directory and links from there.
EOF
}

list_grouped_skills() {
  node - "$GROUPS_FILE" "$REPO_DIR/skills" <<'NODE'
const fs = require("fs");
const path = require("path");
const groups = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const skillsRoot = process.argv[3];

function description(name) {
  const raw = fs.readFileSync(path.join(skillsRoot, name, "SKILL.md"), "utf8");
  const match = raw.match(/^---\r?\n[\s\S]*?\r?\ndescription:\s*(?:"([^"]*)"|'([^']*)'|([^\r\n]*))/);
  return (match?.[1] ?? match?.[2] ?? match?.[3] ?? "").trim();
}

for (const group of groups.groups) {
  console.log(group.label);
  for (const name of group.skills) console.log(`  ${name}  ${description(name)}`);
  for (const provider of group.external_providers ?? []) {
    console.log(`  [plugin] ${provider.id}`);
  }
  console.log();
}
NODE
}

skill_names() {
  find "$REPO_DIR/skills" -mindepth 2 -maxdepth 2 -name SKILL.md -print |
    sed "s#^$REPO_DIR/skills/##; s#/SKILL.md\$##" |
    sort
}

link_skill() {
  local skill="$1"
  local src="$REPO_DIR/skills/$skill"

  if [ ! -f "$src/SKILL.md" ]; then
    echo "ERROR: unknown skill: $skill" >&2
    return 1
  fi

  for target_root in "${LINK_TARGETS[@]}"; do
    mkdir -p "$target_root"
    if [ -e "$target_root/$skill" ] || [ -L "$target_root/$skill" ]; then
      rm -rf "$target_root/$skill"
    fi
    ln -s "$src" "$target_root/$skill"
  done
}

remove_retired_links() {
  [ -f "$GROUPS_FILE" ] || return 0

  local target_root retired link_path
  while IFS= read -r retired; do
    for target_root in "${LINK_TARGETS[@]}"; do
      link_path="$target_root/$retired"
      if [ -L "$link_path" ]; then
        unlink "$link_path"
        echo "  removed retired link: $link_path"
      fi
    done
  done < <(node -e 'for (const name of require(process.argv[1]).retired_skills) console.log(name)' "$GROUPS_FILE")
}

install_repo_skills() {
  local skills=()

  skills_require_primary_worktree "$REPO_DIR" "skills install"

  if [ "$#" -eq 0 ]; then
    echo "Usage: skills install [--all|skill...]" >&2
    return 1
  fi

  if [ "$1" = "--all" ]; then
    remove_retired_links
    while IFS= read -r skill; do
      skills+=("$skill")
    done < <(skill_names)
  else
    skills=("$@")
  fi

  if [ "${#skills[@]}" -eq 0 ]; then
    echo "No skills found." >&2
    return 1
  fi

  echo "==> Linking repo checkout into global agent skill directories"
  for skill in "${skills[@]}"; do
    link_skill "$skill"
    echo "  $skill"
  done

  echo ""
  echo "Installed ${#skills[@]} skill(s). Pull this repo to update linked skill content."
}

add_repo_skill() {
  local cli_dir="$REPO_DIR/skills-cli"

  skills_require_linked_worktree "$REPO_DIR" "skills add"

  if [ ! -f "$cli_dir/dist/cli.mjs" ]; then
    echo "==> Building repo-owned skills CLI"
    pnpm --dir "$cli_dir" install
    pnpm --dir "$cli_dir" run build
  fi

  SKILLS_CONFIG_REPO_DIR="$REPO_DIR" \
    SKILLS_SKIP_GLOBAL_LINKS=1 \
    node "$cli_dir/bin/cli.mjs" add "$@"
}

update_repo() {
  echo "WARNING: skills update-repo is deprecated; preparing reviewed updates instead." >&2
  "$REPO_DIR/scripts/skill-updates.sh" prepare --all
}

doctor() {
  local status=0

  echo "==> skills wrapper"
  echo "  repo: $REPO_DIR"
  echo "  command: ${0}"
  if command -v skills >/dev/null 2>&1; then
    echo "  PATH skills: $(command -v skills)"
  else
    echo "  PATH skills: not found"
    status=1
  fi

  echo ""
  echo "==> dependencies"
  for dep in git node pnpm rsync; do
    if command -v "$dep" >/dev/null 2>&1; then
      echo "  $dep: $(command -v "$dep")"
    else
      echo "  $dep: missing"
      status=1
    fi
  done

  echo ""
  echo "==> repo-owned skills cli"
  if [ -f "$REPO_DIR/skills-cli/dist/cli.mjs" ]; then
    echo "  ok: skills-cli/dist/cli.mjs"
  else
    echo "  missing: skills-cli/dist/cli.mjs (will be built on first skills add)"
  fi

  echo ""
  echo "==> target directories"
  for target_root in "${LINK_TARGETS[@]}"; do
    if [ -d "$target_root" ]; then
      echo "  ok: $target_root"
    else
      echo "  missing: $target_root"
    fi
  done

  echo ""
  echo "==> symlink health"
  local target_root link_path target_path primary_path
  primary_path="$(skills_primary_worktree "$REPO_DIR")"
  for target_root in "${LINK_TARGETS[@]}"; do
    [ -d "$target_root" ] || continue
    while IFS= read -r link_path; do
      target_path="$(readlink "$link_path")"
      if [ -e "$target_path" ]; then
        echo "  ok: $link_path -> $target_path"
        case "$(skills_realpath "$target_path")" in
          "$primary_path"/skills/*) ;;
          *)
            if [ -f "$target_path/SKILL.md" ] && [ -f "$REPO_DIR/skills/$(basename "$link_path")/SKILL.md" ]; then
              echo "  wrong checkout: $link_path must target $primary_path/skills/" >&2
              status=1
            fi
            ;;
        esac
      else
        echo "  broken: $link_path -> $target_path"
        status=1
      fi
    done < <(find "$target_root" -maxdepth 1 -type l -print | sort)
  done

  echo ""
  echo "==> vendor manifest"
  if [ -f "$MANIFEST" ]; then
    if python3 -m json.tool "$MANIFEST" >/dev/null; then
      echo "  ok: $MANIFEST"
      if node - "$MANIFEST" "$REPO_DIR" <<'NODE'
const fs = require("fs");
const path = require("path");
const manifest = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const root = process.argv[3];
const missing = [];
for (const [name, record] of Object.entries(manifest)) {
  if (!fs.existsSync(path.resolve(root, record.vendor_path))) {
    missing.push(`${name}: ${record.vendor_path}`);
  }
  if (!fs.existsSync(path.resolve(root, "skills", name, "SKILL.md"))) {
    missing.push(`${name}: skills/${name}/SKILL.md`);
  }
}
if (missing.length) {
  for (const item of missing) console.error(`  missing: ${item}`);
  process.exit(1);
}
console.log(`  resolved: ${Object.keys(manifest).length} vendor entries`);
NODE
      then
        :
      else
        status=1
      fi
    else
      echo "  invalid json: $MANIFEST"
      status=1
    fi
  else
    echo "  missing: $MANIFEST"
    status=1
  fi

  echo ""
  echo "==> repo skills"
  skill_names | sed 's/^/  /'

  echo ""
  echo "==> grouped catalog"
  local catalog_args=(
    --groups "$GROUPS_FILE"
    --provenance "$PROVENANCE"
    --composites "$COMPOSITES"
  )
  if ! skills_is_primary_worktree "$REPO_DIR"; then
    catalog_args+=(--skip-global-links)
  fi
  if node "$REPO_DIR/scripts/validate-skill-catalog.mjs" "${catalog_args[@]}"; then
    echo "  catalog valid"
  else
    status=1
  fi

  return "$status"
}

cmd="${1:-help}"
case "$cmd" in
  list)
    shift
    list_grouped_skills "$@"
    ;;
  install)
    shift
    install_repo_skills "$@"
    ;;
  add)
    shift
    add_repo_skill "$@"
    ;;
  worktree)
    shift
    subcommand="${1:-}"
    shift || true
    case "$subcommand" in
      create)
        skills_create_review_worktree "$REPO_DIR" "${1:-change}"
        ;;
      *)
        echo "Usage: skills worktree create <slug>" >&2
        exit 1
        ;;
    esac
    ;;
  updates)
    shift
    "$REPO_DIR/scripts/skill-updates.sh" "$@"
    ;;
  apply)
    shift
    skills_require_primary_worktree "$REPO_DIR" "skills apply"
    "$REPO_DIR/scripts/apply.sh" "$@"
    ;;
  update-repo)
    shift
    update_repo "$@"
    ;;
  sync-vendor)
    shift
    skills_require_linked_worktree "$REPO_DIR" "skills sync-vendor"
    "$REPO_DIR/scripts/vendor-sync.sh" "$@"
    ;;
  sync-settings)
    shift
    "$REPO_DIR/scripts/sync-settings.sh" "$@"
    ;;
  doctor)
    shift
    doctor "$@"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
